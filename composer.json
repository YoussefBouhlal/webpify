{
	"name": "youssefbouhlal/webpify",
	"description": "Give your WordPress site a performance boost — effortlessly convert and serve modern image formats (WebP & AVIF) for faster pages and better SEO.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Webpify\\": "Includes/"
		}
	},
	"require": {
		"php": ">=7.4",
		"ext-fileinfo": "*",
		"ext-gd": "*"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml",
		"compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --ignore=vendor/*,node_modules/*,build/* .",
		"format": "phpcbf --standard=phpcs.xml --report-summary --report-source || true",
		"test:unit": "phpunit --configuration phpunit.xml.dist",
		"test:integration": "phpunit --configuration phpunit.integration.xml.dist",
		"test": [
			"@test:unit",
			"@test:integration"
		]
	}
}
